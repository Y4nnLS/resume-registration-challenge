# Optional HTTP port. The server listens only on 127.0.0.1.
PORT=3000

# Local SQL Server in Docker publishes host port 1433 to container port 1433.
# Dedicated SQL login; replace placeholders only in your ignored local .env.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=ResumeRegistration
DB_USER=resume_app
DB_PASSWORD=replace_with_your_local_password
DB_ENCRYPT=true
# Local SQL Server with a self-signed certificate only.
DB_TRUST_SERVER_CERTIFICATE=true

# Real integration tests use ONLY TEST_DB_*. The name MUST end in _test.
# Provision this separate database with its dedicated resume_test login first.
# TEST_DB_SERVER=127.0.0.1
# TEST_DB_PORT=1433
# TEST_DB_NAME=ResumeRegistration_test
# TEST_DB_USER=resume_test
# TEST_DB_PASSWORD=replace_with_your_local_test_password
# TEST_DB_ENCRYPT=true
# TEST_DB_TRUST_SERVER_CERTIFICATE=true
